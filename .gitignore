# ==============================================================================
# SkyDish - Git Ignore Configuration
# ==============================================================================

# Environment Variables & Secret Files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
id_ed25519*

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
build/
*/build/
dist/
*/dist/

# Test Coverage
coverage/
*/coverage/
.nyc_output/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log
error.log

# Local Database Dumps & Storage Engines
data/
data/db/
*.sqlite
*.sqlite3
*.sqlite-journal

# IDE & Editor Temporary Configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary Scratch Files
*.tmp
crs_extracted.txt
