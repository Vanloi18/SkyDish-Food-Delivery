# SkyDish Global Environment Configuration Example
MONGO_URI=mongodb://127.0.0.1:27000/food_delivery_db
MONGO_PORT=27017
JWT_SECRET=supersecretjwtkeyforfooddeliverymicroservices2025
JWT_EXPIRES_IN=7d

# Microservice Ports
AUTH_PORT=4000
REST_PORT=5002
DELIVERY_PORT=5003
PAYMENT_PORT=5004
ORDER_PORT=5005
FRONTEND_PORT=3000

# Payment Gateway Credentials (Sandbox/Test)
STRIPE_SECRET_KEY=sk_test_placeholder_for_testing
VNPAY_ENABLED=false
VNPAY_TMN_CODE=TESTCODE
VNPAY_HASH_SECRET=replace_with_vnpay_sandbox_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_VERSION=2.1.0
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/callback
VNPAY_IPN_URL=http://localhost:5004/webhooks/vnpay/ipn
MOMO_PARTNER_CODE=MOMO_PARTNER_TEST
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY_TEST
MOMO_SECRET_KEY=MOMO_SECRET_KEY_TEST
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3300/payment/momo/callback
MOMO_IPN_URL=http://localhost:5004/api/payment/momo/ipn

# Docker Network Configuration (Defaults for Docker Compose mode)
DOCKER_MONGO_URI=mongodb://mongo:27017/food_delivery_db
ORDER_SERVICE_URL=http://order-service:5005

# Bank Transfer / VietQR Configuration
BANK_TRANSFER_ENABLED=true
BANK_ID=970415
BANK_CODE=ICB
BANK_NAME=VietinBank
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=SKYDISH FOOD DELIVERY
VIETQR_TEMPLATE=compact2

# Geocoding Service (Optional - OpenCage Data)
OPENCAGE_API_KEY=your_opencage_api_key_here

# SMTP Email Notification Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=false
MAIL_FROM_NAME="SkyDish Food Delivery"
MAIL_FROM_ADDRESS=noreply@skydish.com

