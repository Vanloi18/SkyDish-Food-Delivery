# SkyDish Food Delivery Platform - Environment Variables Template
# Copy this file to .env and provide your actual values.
# NEVER commit .env to version control!

# ==============================================================================
# 1. DATABASE CONFIGURATION
# ==============================================================================
# Shared MongoDB Connection URI:
# - For Docker Compose (default): mongodb://mongo:27017/food_delivery_db
# - For host-only dev (without Docker): mongodb://127.0.0.1:27017/food_delivery_db
MONGO_URI=mongodb://mongo:27017/food_delivery_db
MONGO_PORT=27017

# ==============================================================================
# 2. MICROSERVICE PORTS
# ==============================================================================
FRONTEND_PORT=3000
AUTH_PORT=4000
REST_PORT=5002
ORDER_PORT=5005
DELIVERY_PORT=5003
PAY_PORT=5004

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
JWT_SECRET=supersecretjwtkeyforfooddeliverymicroservices2025
JWT_EXPIRES_IN=7d

# ==============================================================================
# 4. PAYMENT GATEWAYS
# ==============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# VNPay Sandbox / Production Configuration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/callback

# MoMo Sandbox / Production Configuration
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo/callback
MOMO_IPN_URL=http://localhost:5004/api/payment/momo/ipn

# Bank Transfer / VietQR Configuration
BANK_TRANSFER_ENABLED=true
BANK_ID=970422
BANK_CODE=MB
BANK_NAME=MB Bank
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2

# ==============================================================================
# 5. FRONTEND SETTINGS
# ==============================================================================
REACT_APP_BACKEND_URL=http://localhost:4000

# ==============================================================================
# 6. NOTIFICATION SERVICES (OPTIONAL)
# ==============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
